<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- A Magid tagpack: double-precision arithmetic, rounding, statistics and trigonometry for MagidML stories.
         It compiles against magid-api alone; the server provides the API at run time. -->
    <groupId>com.zarterstein</groupId>
    <artifactId>magid-math</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>magid-math</name>
    <description>Magid tagpack: double-precision math for MagidML stories (prefix "math")</description>
    <url>https://github.com/tearim/magid-module-math</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Mark-Marion Gondelman</name>
            <roles>
                <role>orchestration</role>
            </roles>
        </developer>
        <developer>
            <name>Claude Code (Anthropic)</name>
            <roles>
                <role>agentic implementation</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/tearim/magid-module-math</url>
        <connection>scm:git:https://github.com/tearim/magid-module-math.git</connection>
    </scm>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <magid-api.version>0.1-SNAPSHOT</magid-api.version>
        <!-- The engine the story tests run on (profile "engine") -->
        <magid.version>1.0-SNAPSHOT</magid.version>
    </properties>

    <!-- magid-api is published to GitHub Packages; Maven needs a token to read it, even though it is public. -->
    <repositories>
        <repository>
            <id>github</id>
            <name>GitHub Packages: magid-api</name>
            <url>https://maven.pkg.github.com/tearim/magid-api</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.0.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The server provides the API at run time (a pack's class loader asks the server for it) -->
        <dependency>
            <groupId>com.zarterstein</groupId>
            <artifactId>magid-api</artifactId>
            <version>${magid-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- The manifest is a filtered resource: target/classes is then also the pack in its directory form
                 (classes/META-INF/MANIFEST.MF, for a server's magid.plugins.dev), and the jar uses the same file. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Story tests: the pack loaded as a server loads it (plugin directory, PackDiscovery) and stories played
             by the real engine. The engine (magid-core) isn't public, so the profile turns itself on where it is in
             the local Maven repository (mvn install in the Magid repository), and the public CI runs the unit tests
             only. Tests: src/engine-test. -->
        <profile>
            <id>engine</id>
            <activation>
                <file>
                    <exists>${user.home}/.m2/repository/com/zarterstein/magid-core</exists>
                </file>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.zarterstein</groupId>
                    <artifactId>magid-core</artifactId>
                    <version>${magid.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>com.zarterstein</groupId>
                    <artifactId>magid-story-server-plugins</artifactId>
                    <version>${magid.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>engine-test-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/engine-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
